# Copy to .env for local development. Never commit .env or a real key.

# LLM planner. Without a key the app falls back to deterministic routing: the
# app still runs and every MCP tool still works, but tool selection is rule-based
# rather than model-driven. Add these in Render/Railway for the graded demo.
OPENAI_API_KEY=
# The default is the GPT-5.6 Sol flagship model. It requires a funded API
# account; choose an override only intentionally and after testing its tools.
OPENAI_MODEL=gpt-5.6-sol

# Temporary local troubleshooting only. When true, a fallback response includes
# the provider exception class/status/code (never raw error text). Leave false
# for a public deployment and inspect secure host logs for full details.
EXPOSE_PLANNER_ERRORS=false

# Retrieval tuning. TOP_K is the ablation variable reported in evaluation/results.md.
TOP_K=4

# Minimum share of a question's distinctive words that must appear in the top
# retrieved chunk before the corpus is treated as having evidence at all.
MIN_SUPPORT=0.34

# Upper bound on planner tool-call rounds per request.
MAX_TOOL_ITERATIONS=6

# Bound waits so a stalled provider or local MCP child cannot hold a request.
LLM_TIMEOUT_SECONDS=35
LLM_MAX_RETRIES=1
MCP_OPERATION_TIMEOUT_SECONDS=12
MCP_SHUTDOWN_TIMEOUT_SECONDS=10

# Lightweight one-process demo protection for a public deployment. These are
# not a substitute for an edge/WAF rate limiter on a multi-instance service.
CHAT_RATE_WINDOW_SECONDS=60
CHAT_RATE_LIMIT=30
GLOBAL_CHAT_RATE_LIMIT=60
